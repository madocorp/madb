<Root>

  <Panel name="connection-editor-mysql">
    <PanelTitle>MySQL connection editor</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <Label>Name: <Input name="name" /></Label>
        <Label>Hostname: <Input name="host" placeholder="anything" /></Label>
        <Label>Port: <Input name="port" /></Label>
        <Label>Timeout: <Input name="timeout" /></Label>
        <Label>Init command file: <Input name="initCommand" /></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Username: <Input name="username"/></Label>
        <Label>Password: <Input name="password"/></Label>
        <Label>SSL Key file: <File name="sslKey" file="true" start="~" placeholder="Press space to choose a file!" /></Label>
        <Label>SSL CERT file: <File name="sslCert" file="true" start="~" placeholder="Press space to choose a file!" /></Label>
        <Label>SSL CA file: <File name="sslCA" file="true" start="~" placeholder="Press space to choose a file!" /></Label>
        <Label>SSL Cipher: <File name="sslCipher" file="true" start="~" placeholder="Press space to choose a file!" /></Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Connection\EditController::saveMySQL">Save</Button><Space />
        <Button hotKey="F1" onPress="MADB\Connection\EditController::testMySQL">Test connection</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Connection\EditController::close">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-editor-mongodb">
    <PanelTitle>MongoDB connection editor</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <Label>Name: <Input name="name"/></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Connection\EditController::saveMongoDB">Save</Button><Space />
        <Button hotKey="F1" onPress="MADB\Connection\EditController::testMongoDB">Test connection</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Connection\EditController::close">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-sort">
    <PanelTitle>Sort connections</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <ListBox name="order" valueType="order" movable="true">
        </ListBox>
      </HalfBoxLeft>
      <HalfBoxRight>
        Shift + Up/Down: Move item<NL/>
        Insert: Add/delete separator
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Connection\SortController::save">Save</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Connection\SortController::close">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-status">
    <PanelTitle>Connection status</PanelTitle>
    <PanelContent>
      <Label>
        <ListHeaderRow>
          <Header class="w10">PID</Header>
          <Header class="w40">Connection</Header>
          <Header class="w20">Type</Header>
          <Header class="w20">Status</Header>
          <Header class="w10">Time</Header>
        </ListHeaderRow>
        <ListBox name="status" onSelect="MADB\Connection\StatusController::info"></ListBox>
      </Label>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Connection\StatusController::info">ShowInfo</Button><Space />
        <Button hotKey="F9" onPress="MADB\Connection\StatusController::kill">Kill</Button><Space />
        <Button hotKey="F3" onPress="MADB\Connection\StatusController::refresh">Refresh</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Connection\StatusController::close">Close</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-process-info" class="w55">
    <PanelTitle>Process status</PanelTitle>
    <PanelContent>
      <Label>
        Process info:
        <TextBox name="process">PID, status, since</TextBox>
      </Label>
      <Label>
        Connection info:
        <TextBox name="connection">name, type, etc...</TextBox>
      </Label>
      <Label>
        Job info:
        <TextBox name="job">command, arguments</TextBox>
      </Label>
      <ButtonBox>
        <Button name="connection-process-ok" hotKey="RETURN" onPress="MADB\Main\PanelController::closePanel">OK</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

</Root>
