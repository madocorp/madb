<Root>

  <Panel name="connection-editor-mysql">
    <PanelTitle>MySQL connection editor</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <Label>Name: <Input name="name"/></Label>
        <Label>Hostname: <Input name="host"/></Label>
        <Label>Port: <Input name="port"/></Label>
        <Label>Default schema: <Input name="schema"/></Label>
        <Label>Timeout: <Input name="timeout"/></Label>
        <Label>Init command file: <Input name="initCommand"/></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Username: <Input name="username"/></Label>
        <Label>Password: <Input name="password"/></Label>
        <Label>SSL Key file: <Input name="sslKey"/></Label>
        <Label>SSL CERT file: <Input name="sslCert"/></Label>
        <Label>SSL CA file: <Input name="sslCA"/></Label>
        <Label>SSL Cipher: <Input name="sslCipher"/></Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Connection\EditController::close">Cancel</Button>
        <Button hotKey="F1" onPress="MADB\Connection\EditController::testMySQL">Test connection</Button>
        <Button hotKey="RETURN" onPress="MADB\Connection\EditController::saveMySQL">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-editor-mongodb">
    <PanelTitle>MongoDB connection editor</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <Label>Name: <Input name="name"/></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Connection\EditController::close">Cancel</Button>
        <Button hotKey="F1" onPress="MADB\Connection\EditController::testMongoDB">Test connection</Button>
        <Button hotKey="RETURN" onPress="MADB\Connection\EditController::saveMongoDB">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="connection-sort">
    <PanelTitle>Sort connections</PanelTitle>
    <PanelContent>
      <HalfBoxLeft>
        <ListBox name="order" moveable="true">
        </ListBox>
      </HalfBoxLeft>
      <HalfBoxRight>
        Shift + Up/Down: Move item<NL/>
        Insert: Add/delete separator
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Connection\SortController::close">Cancel</Button>
        <Button hotKey="RETURN" onPress="MADB\Connection\SortController::save">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

</Root>
