<Root>

  <SubMenu>
    <MenuBox belongsTo="menu-table" name="menu-table-list" typing="search">
      <MenuBoxItem>Select a schema!</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-table-operations" submenu="true">
      <MenuBoxItem onOpen="MADB\Table\EditorController::openCreate">Table</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\ViewController::openCreate">View</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-table-item-actions" submenu="true">
      <MenuBoxItem onOpen="MADB\Table\RowsController::selectRows">Select</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\ShowCreateController::showCreate">ShowCreate</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\MenuController::modify">Modify</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\CopyController::copy">Copy</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\MenuController::drop">Drop</MenuBoxItem>
    </MenuBox>
  </SubMenu>

  <Panel name="table-editor" arrowTabs="true">
    <PanelTitle>Table editor</PanelTitle>
    <PanelContent>
      <Tabs name="table-editor-tabs" onChange="MADB\Table\EditorController::updateAddButton">
        <Tab contentName="table-editor-main">Main</Tab>
        <Tab contentName="table-editor-column">Column</Tab>
        <Tab contentName="table-editor-index">Index</Tab>
        <Tab contentName="table-editor-foreign-key">Foreign key</Tab>
        <Tab contentName="table-editor-trigger">Trigger</Tab>
      </Tabs>

      <TabBox name="table-editor-main" class="table-editor-tab">
        <Label>Name: <Input name="table-name" /></Label><NL /><NL />
        <Label>Charset: <Select name="table-charset" hint="Select charset..." /></Label>
        <Label>Collation: <Select name="table-collation" hint="Select collation..."  /></Label>
        <Label>Engine: <Select name="table-engine" hint="Select engine..." /></Label>
        <Label>Comment: <TextEditor name="table-comment" /></Label>
      </TabBox>

      <TabBox name="table-editor-column" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w20">Name</Header>
          <Header class="w20">Type</Header>
          <Header class="w40">Attributes</Header>
          <Header class="w20">Default</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-columns" class="table-editor-list table-editor-list-with-header" movable="true" onSelect="MADB\Table\ColumnEditorController::openColumnEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-index" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w25">Type</Header>
          <Header class="w50">Columns</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-indexes" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\IndexEditorController::openIndexEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-foreign-key" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w20">Column</Header>
          <Header class="w40">References</Header>
          <Header class="w15">Rules</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-foreign-keys" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\ForeignKeyEditorController::openForeignKeyEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-trigger" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w10">Timing</Header>
          <Header class="w10">Event</Header>
          <Header class="w55">Statement</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-triggers" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\TriggerEditorController::openTriggerEditor"></ListBox>
      </TabBox>

      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\EditorController::generate">Generate</Button><Space name="table-editor-add-space" />
        <Button name="table-editor-add" hotKey="INSERT" onPress="MADB\Table\EditorController::add">Add</Button><Space />
        <Button name="table-editor-delete" hotKey="DELETE" onPress="MADB\Table\EditorController::delete">Delete</Button><Space name="table-editor-delete-space" />
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditorController::close">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="view-editor">
    <PanelTitle>View editor</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="view-name" /></Label>
      <Label>Definition: <TextEditor name="view-definition" /></Label>
      <HalfBoxLeft>
        <Label>Algorithm:
          <Select name="view-algorithm" class="view-option-select">
            <Option value="">Default</Option>
            <Option value="UNDEFINED">UNDEFINED</Option>
            <Option value="MERGE">MERGE</Option>
            <Option value="TEMPTABLE">TEMPTABLE</Option>
          </Select>
        </Label>
        <Label>SQL security:
          <Select name="view-security" class="view-option-select">
            <Option value="">Default</Option>
            <Option value="DEFINER">DEFINER</Option>
            <Option value="INVOKER">INVOKER</Option>
          </Select>
        </Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Definer: <Input name="view-definer" /></Label>
        <Label>Check option:
          <Select name="view-check-option" class="view-option-select">
            <Option value="">None</Option>
            <Option value="CASCADED">CASCADED</Option>
            <Option value="LOCAL">LOCAL</Option>
          </Select>
        </Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\ViewController::generate">Generate</Button>
        <Button hotKey="ESCAPE" onPress="MADB\Main\PanelController::closePanel">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-copy">
    <PanelTitle>Copy table</PanelTitle>
    <PanelContent>
      <Label>Target schema: <Select name="table-copy-schema" hint="Select schema..." /></Label>
      <Label>Target table: <Input name="table-copy-table" /></Label>
      <ButtonBox>
        <Button name="table-copy-generate" hotKey="RETURN" onPress="MADB\Table\CopyController::saveCopy">Generate</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Main\PanelController::closePanel">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-column-editor">
    <PanelTitle>Column</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="column-name" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" /></Label>
      <HalfBoxLeft>
        <Label>Type:
          <ListBox name="column-type" class="column-type-list">
            <ListItem value="INT">INT</ListItem>
            <ListItem value="BIGINT">BIGINT</ListItem>
            <ListItem value="DECIMAL">DECIMAL</ListItem>
            <ListItem value="VARCHAR">VARCHAR</ListItem>
            <ListItem value="CHAR">CHAR</ListItem>
            <ListItem value="TEXT">TEXT</ListItem>
            <ListItem value="LONGTEXT">LONGTEXT</ListItem>
            <ListItem value="DATE">DATE</ListItem>
            <ListItem value="DATETIME">DATETIME</ListItem>
            <ListItem value="TIMESTAMP">TIMESTAMP</ListItem>
            <ListItem value="ENUM">ENUM</ListItem>
            <ListItem value="SET">SET</ListItem>
            <ListItem value="JSON">JSON</ListItem>
            <ListItem value="BLOB">BLOB</ListItem>
          </ListBox>
        </Label>
        <Label>Parameter: <Input name="column-parameter" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" /></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <CheckBox name="column-primary" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Primary key</CheckBox>
        <CheckBox name="column-unique" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Unique</CheckBox><NL />
        <CheckBox name="column-not-null" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Not null</CheckBox><NL />
        <CheckBox name="column-auto-increment" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Auto increment</CheckBox><NL />
        <CheckBox name="column-unsigned" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Unsigned</CheckBox>
        <CheckBox name="column-zerofill" onChange="MADB\Table\ColumnEditorController::syncColumnEditor">Zerofill</CheckBox>
        <Label>Default: <Input name="column-default" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" /></Label>
        <Label>Charset: <Select name="column-charset" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" hint="Select charset..." /></Label>
        <Label>Collation: <Select name="column-collation" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" hint="Select collation..." /></Label>
        <Label>Comment: <Input name="column-comment" onChange="MADB\Table\ColumnEditorController::syncColumnEditor" /></Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\ColumnEditorController::saveColumnEditor">Save</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditorController::closeItemEditor">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-index-editor">
    <PanelTitle>Index</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="index-name" /></Label>
      <HalfBoxLeft>
        <Label>Columns: <ListBox name="index-columns" valueType="select" selectionOrder="true" selectOnReturn="false"></ListBox></Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Type:
          <ListBox name="index-type">
            <ListItem value="INDEX">INDEX</ListItem>
            <ListItem value="UNIQUE">UNIQUE</ListItem>
            <ListItem value="PRIMARY">PRIMARY</ListItem>
            <ListItem value="FULLTEXT">FULLTEXT</ListItem>
            <ListItem value="SPATIAL">SPATIAL</ListItem>
          </ListBox>
        </Label>
        <Label>Storage Type:
          <ListBox name="storage-type">
            <ListItem value="DEFAULT">DEFAULT</ListItem>
            <ListItem value="BTREE">BTREE</ListItem>
            <ListItem value="HASH">HASH</ListItem>
            <ListItem value="FULLTEXT">FULLTEXT</ListItem>
            <ListItem value="RTREE">RTREE</ListItem>
          </ListBox>
        </Label>
        <Block>
          Available index methods depend on the table engine, index kind, and column types. MySQL may reject unsupported combinations.
        </Block>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\IndexEditorController::saveIndexEditor">Save</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditorController::closeItemEditor">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-foreign-key-editor">
    <PanelTitle>Foreign key</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="foreign-key-name" /></Label>
      <HalfBoxLeft>
        <Label>Schema:<Field name="foreign-key-schema" /></Label>
        <Label>Table: <Field name="foreign-key-table" /></Label>
        <Label>Column(s): <ListBox name="foreign-key-column" valueType="select" selectionOrder="true" selectOnReturn="false" /></Label>
        <Label>Update rule:
          <Select name="foreign-key-update-rule" hint="Select rule...">
            <Option>RESTRICT</Option>
            <Option>CASCADE</Option>
            <Option>SET NULL</Option>
            <Option>NO ACTION</Option>
            <Option>SET DEFAULT</Option>
          </Select>
        </Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Referenced schema: <Select name="foreign-key-target-schema" hint="Select schema..." onChange="MADB\Table\ForeignKeyEditorController::changeForeignKeyTargetSchema" /></Label>
        <Label>Referenced table: <Select name="foreign-key-target-table" hint="Select table..." onChange="MADB\Table\ForeignKeyEditorController::changeForeignKeyTargetTable" /></Label>
        <Label>Referenced column(s): <ListBox name="foreign-key-target-column" valueType="select" selectionOrder="true" selectOnReturn="false" /></Label>
        <Label>Delete rule:
          <Select name="foreign-key-delete-rule" hint="Select rule...">
            <Option>RESTRICT</Option>
            <Option>CASCADE</Option>
            <Option>SET NULL</Option>
            <Option>NO ACTION</Option>
            <Option>SET DEFAULT</Option>
          </Select>
        </Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\ForeignKeyEditorController::saveForeignKeyEditor">Save</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditorController::closeItemEditor">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-trigger-editor">
    <PanelTitle>Trigger</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="trigger-name" /></Label>
      <HalfBoxLeft>
        <Label>Timing:
          <Select name="trigger-timing" hint="Select timing...">
            <Option>BEFORE</Option>
            <Option>AFTER</Option>
          </Select>
        </Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Event:
          <Select name="trigger-event" hint="Select event...">
            <Option>INSERT</Option>
            <Option>UPDATE</Option>
            <Option>DELETE</Option>
          </Select>
        </Label>
      </HalfBoxRight>
      <Label>Statement: <TextEditor name="trigger-statement" /></Label>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Table\TriggerEditorController::saveTriggerEditor">Save</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditorController::closeItemEditor">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

</Root>
