<Root>

  <Panel name="table-editor" arrowTabs="true">
    <PanelTitle>Table editor</PanelTitle>
    <PanelContent>
      <Tabs name="table-editor-tabs">
        <Tab contentName="table-editor-main">Main</Tab>
        <Tab contentName="table-editor-column">Column</Tab>
        <Tab contentName="table-editor-index">Index</Tab>
        <Tab contentName="table-editor-foreign-key">Foreign key</Tab>
        <Tab contentName="table-editor-trigger">Trigger</Tab>
      </Tabs>

      <TabBox name="table-editor-main" class="table-editor-tab">
        <Label>Name: <Input name="table-name" /></Label>
        <Label>Charset: <Input name="table-charset" /></Label>
        <Label>Collation: <Input name="table-collation" /></Label>
        <Label>Comment: <Input name="table-comment" /></Label>
      </TabBox>

      <TabBox name="table-editor-column" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w20">Name</Header>
          <Header class="w20">Type</Header>
          <Header class="w40">Attributes</Header>
          <Header class="w20">Default</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-columns" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\EditController::openColumnEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-index" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w25">Type</Header>
          <Header class="w50">Columns</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-indexes" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\EditController::openIndexEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-foreign-key" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w20">Column</Header>
          <Header class="w40">References</Header>
          <Header class="w15">Rules</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-foreign-keys" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\EditController::openForeignKeyEditor"></ListBox>
      </TabBox>

      <TabBox name="table-editor-trigger" class="table-editor-tab">
        <ListHeaderRow>
          <Header class="w25">Name</Header>
          <Header class="w10">Timing</Header>
          <Header class="w10">Event</Header>
          <Header class="w55">Statement</Header>
        </ListHeaderRow>
        <ListBox name="table-editor-triggers" class="table-editor-list table-editor-list-with-header" onSelect="MADB\Table\EditController::openTriggerEditor"></ListBox>
      </TabBox>

      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditController::close">Cancel</Button><Space />
        <Button hotKey="RETURN" onPress="MADB\Table\EditController::generate">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-column-editor">
    <PanelTitle>Column</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="column-name" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
      <HalfBoxLeft>
        <Label>Type:
          <ListBox name="column-type" class="column-type-list" onSelect="MADB\Table\EditController::selectColumnType">
            <ListItem value="INT">INT</ListItem>
            <ListItem value="BIGINT">BIGINT</ListItem>
            <ListItem value="DECIMAL">DECIMAL</ListItem>
            <ListItem value="VARCHAR">VARCHAR</ListItem>
            <ListItem value="CHAR">CHAR</ListItem>
            <ListItem value="TEXT">TEXT</ListItem>
            <ListItem value="LONGTEXT">LONGTEXT</ListItem>
            <ListItem value="DATE">DATE</ListItem>
            <ListItem value="DATETIME">DATETIME</ListItem>
            <ListItem value="TIMESTAMP">TIMESTAMP</ListItem>
            <ListItem value="ENUM">ENUM</ListItem>
            <ListItem value="SET">SET</ListItem>
            <ListItem value="JSON">JSON</ListItem>
            <ListItem value="BLOB">BLOB</ListItem>
          </ListBox>
        </Label>
      </HalfBoxLeft>
      <HalfBoxRight>
        <Label>Parameter: <Input name="column-parameter" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
        <CheckBox name="column-primary" onChange="MADB\Table\EditController::syncColumnEditor">Primary key</CheckBox>
        <CheckBox name="column-unique" onChange="MADB\Table\EditController::syncColumnEditor">Unique</CheckBox>
        <CheckBox name="column-not-null" onChange="MADB\Table\EditController::syncColumnEditor">Not null</CheckBox>
        <CheckBox name="column-auto-increment" onChange="MADB\Table\EditController::syncColumnEditor">Auto increment</CheckBox>
        <CheckBox name="column-unsigned" onChange="MADB\Table\EditController::syncColumnEditor">Unsigned</CheckBox>
        <CheckBox name="column-zerofill" onChange="MADB\Table\EditController::syncColumnEditor">Zerofill</CheckBox>
        <Label>Default: <Input name="column-default" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
        <Label>Charset: <Input name="column-charset" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
        <Label>Collation: <Input name="column-collation" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
        <Label>Comment: <Input name="column-comment" onChange="MADB\Table\EditController::syncColumnEditor" /></Label>
      </HalfBoxRight>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditController::closeItemEditor">Cancel</Button><Space />
        <Button hotKey="RETURN" onPress="MADB\Table\EditController::saveColumnEditor">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-index-editor">
    <PanelTitle>Index</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="index-name" /></Label>
      <Label>Type: <Input name="index-type" /></Label>
      <Label>Unique: <Input name="index-unique" /></Label>
      <Label>Columns: <Input name="index-columns" /></Label>
      <Label>Cardinality: <Input name="index-cardinality" /></Label>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditController::closeItemEditor">Cancel</Button><Space />
        <Button hotKey="RETURN" onPress="MADB\Table\EditController::saveIndexEditor">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-foreign-key-editor">
    <PanelTitle>Foreign key</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="foreign-key-name" /></Label>
      <Label>Column: <Input name="foreign-key-column" /></Label>
      <Label>Referenced schema: <Input name="foreign-key-target-schema" /></Label>
      <Label>Referenced table: <Input name="foreign-key-target-table" /></Label>
      <Label>Referenced column: <Input name="foreign-key-target-column" /></Label>
      <Label>Update rule: <Input name="foreign-key-update-rule" /></Label>
      <Label>Delete rule: <Input name="foreign-key-delete-rule" /></Label>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditController::closeItemEditor">Cancel</Button><Space />
        <Button hotKey="RETURN" onPress="MADB\Table\EditController::saveForeignKeyEditor">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="table-trigger-editor">
    <PanelTitle>Trigger</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="trigger-name" /></Label>
      <Label>Timing: <Input name="trigger-timing" /></Label>
      <Label>Event: <Input name="trigger-event" /></Label>
      <Label>Statement: <Input name="trigger-statement" /></Label>
      <ButtonBox>
        <Button hotKey="ESCAPE" onPress="MADB\Table\EditController::closeItemEditor">Cancel</Button><Space />
        <Button hotKey="RETURN" onPress="MADB\Table\EditController::saveTriggerEditor">Save</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

</Root>
