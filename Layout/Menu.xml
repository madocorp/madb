<Root>

  <MenuBar>
    <MenuBarItem name="menu-connection">Connection</MenuBarItem>
    <MenuBarItem name="menu-schema">Schema</MenuBarItem>
    <MenuBarItem name="menu-table">Table</MenuBarItem>
    <MenuBarItem name="menu-result">Result</MenuBarItem>
    <MenuBarItem name="menu-query">Query</MenuBarItem>
    <MenuBarItem name="menu-list">List</MenuBarItem>
    <MenuBarItem name="menu-madb">MaDB</MenuBarItem>
  </MenuBar>

  <SubMenu>
    <MenuBox belongsTo="menu-connection" name="submenu-connection">
      <MenuBoxItem name="menu-connection-manage" submenu="true" class="MenuSeparator">Manage</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-connection-manage" submenu="true">
      <MenuBoxItem name="menu-connection-create" submenu="true">Create</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\EditController::edit">Edit</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\SortController::sort">Sort</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\MenuController::delete">Delete</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\StatusController::show">Status</MenuBoxItem>
      <MenuBoxItem name="menu-connection-cache" submenu="true">Cache</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-connection-create" submenu="true">
      <MenuBoxItem onOpen="MADB\Connection\EditController::createMySQL">MySQL</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\EditController::createMongoDB">MongoDB</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-connection-cache" submenu="true">
      <MenuBoxItem onOpen="MADB\Connection\MenuController::clearCurrentCache">Clear current</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Connection\MenuController::clearAllCache">Clear all</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-schema" name="menu-schema-list" typing="search">
      <MenuBoxItem>Select a connection!</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-schema-operations" submenu="true">
      <MenuBoxItem onOpen="MADB\Schema\CreateController::create">Create</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Schema\RenameController::rename">Rename</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Schema\DropController::drop">Drop</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-table" name="menu-table-list" typing="search">
      <MenuBoxItem>Select a schema!</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-table-operations" submenu="true">
      <MenuBoxItem onOpen="MADB\Table\EditorController::openCreate">Table</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-table-item-actions" submenu="true">
      <MenuBoxItem onOpen="MADB\Table\RowsController::selectRows">Select</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\RowsController::showRows">Show</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\ShowCreateController::showCreate">ShowCreate</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\EditorController::openModify">Modify</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\EditorController::openColumns">Columns</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\EditorController::openIndexes">Index</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\EditorController::openForeignKeys">ForeignKey</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\EditorController::openTriggers">Trigger</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Table\CopyController::copy">Copy</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-result">
      <MenuBoxItem onOpen="">Export</MenuBoxItem>
      <MenuBoxItem onOpen="">Filter</MenuBoxItem>
      <MenuBoxItem onOpen="">Search</MenuBoxItem>
      <MenuBoxItem onOpen="">Info</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-query">
      <MenuBoxItem onOpen="MADB\Main\QueryExecutionController::executeQuery">Execute</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryExecutionController::executeCurrentQuery">Execute one</MenuBoxItem>
      <MenuBoxItem name="menu-query-templates" submenu="true">Templates</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::editQuery">Edit</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::formatQuery">Format</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::revertQuery">Revert</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::clearQuery">Clear</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::importQuery">Import</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryEditorController::exportQuery">Export</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QuerySearchController::searchQuery">Search</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-query-templates" submenu="true">
      <MenuBoxItem value="SELECT current" onOpen="MADB\Main\QueryEditorController::insertTemplate">SELECT current</MenuBoxItem>
      <MenuBoxItem value="INSERT" onOpen="MADB\Main\QueryEditorController::insertTemplate">INSERT</MenuBoxItem>
      <MenuBoxItem value="UPDATE" onOpen="MADB\Main\QueryEditorController::insertTemplate">UPDATE</MenuBoxItem>
      <MenuBoxItem value="ON DUPLICATE" onOpen="MADB\Main\QueryEditorController::insertTemplate">ON DUPLICATE</MenuBoxItem>
      <MenuBoxItem value="JOIN" onOpen="MADB\Main\QueryEditorController::insertTemplate">JOIN</MenuBoxItem>
      <MenuBoxItem value="DELETE" onOpen="MADB\Main\QueryEditorController::insertTemplate">DELETE</MenuBoxItem>
      <MenuBoxItem value="GROUP CONCAT MAX LENGTH" onOpen="MADB\Main\QueryEditorController::insertTemplate">GROUP CONCAT MAX LENGTH</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-list">
      <MenuBoxItem onOpen="MADB\Main\QueryListController::newQuery">New</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryListController::cloneQuery">Clone</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryListController::renameQuery">Rename</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryListController::togglePinQuery">Pin</MenuBoxItem>
      <MenuBoxItem onOpen="">Search</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Main\QueryListController::deleteQuery">Delete</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-madb">
      <MenuBoxItem onOpen="">Settings</MenuBoxItem>
      <MenuBoxItem onOpen="">Help</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Config\MenuController::about">About</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Config\MenuController::quit">Exit</MenuBoxItem>
    </MenuBox>
  </SubMenu>

</Root>
