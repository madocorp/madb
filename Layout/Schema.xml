<Root>

  <SubMenu>
    <MenuBox belongsTo="menu-schema" name="menu-schema-list" typing="search">
      <MenuBoxItem>Select a connection!</MenuBoxItem>
    </MenuBox>
    <MenuBox belongsTo="menu-schema-operations" submenu="true">
      <MenuBoxItem onOpen="MADB\Schema\CreateController::create">Create</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Schema\RenameController::rename">Rename</MenuBoxItem>
      <MenuBoxItem onOpen="MADB\Schema\DropController::drop">Drop</MenuBoxItem>
    </MenuBox>
  </SubMenu>

  <Panel name="schema-create">
    <PanelTitle>Create schema</PanelTitle>
    <PanelContent>
      <Label>Name: <Input name="name" /></Label>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Schema\CreateController::generateCreate">Generate</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Schema\CreateController::closeCreate">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

  <Panel name="schema-rename">
    <PanelTitle>Rename schema</PanelTitle>
    <PanelContent>
      <Label>New name: <Input name="name" /></Label>
      <ButtonBox>
        <Button hotKey="RETURN" onPress="MADB\Schema\RenameController::generateRename">Generate</Button><Space />
        <Button hotKey="ESCAPE" onPress="MADB\Schema\RenameController::closeRename">Cancel</Button>
      </ButtonBox>
    </PanelContent>
  </Panel>

</Root>
