<Root>
  <Screen>
    <Box name="query-editor-container">
      <Box name="query-title">
        <Box name="connection-info">localhost : test-schema</Box>
        <Box name="query-name">#1 - NEW</Box>
      </Box>
      <TextEditor name="query-editor" tokenizer="\MADB\Tokenizer\Sql"></TextEditor>
      <Box name="query-result-preview">
        <TextPreview name="query-result-preview-text" class="query-result-preview-text"></TextPreview>
      </Box>
    </Box>
    <Box name="query-result-container">
      <Box name="query-result">
        <Box name="query-result-message"></Box>
        <Box name="query-result-status"></Box>
        <Table name="query-result-table" chunkSize="10000" rowNumbers="true" />
      </Box>
    </Box>
    <Box name="query-list-container">
      <ListBox name="query-list" movable="true">
      </ListBox>
    </Box>
    <Panel name="query-rename">
      <PanelTitle>Rename query</PanelTitle>
      <PanelContent>
        <Label>Name: <Input name="name" /></Label>
        <ButtonBox>
          <Button hotKey="RETURN" onPress="MADB\Main\QueryEditorController::saveRename">Save</Button><Space />
          <Button hotKey="ESCAPE" onPress="MADB\Main\PanelController::closePanel">Cancel</Button>
        </ButtonBox>
      </PanelContent>
    </Panel>
    <Panel name="query-field-value">
      <PanelTitle>Field value</PanelTitle>
      <PanelContent>
        <TextBox name="query-field-value-text" class="query-field-value-text"></TextBox>
        <ButtonBox>
          <Button hotKey="SPACE" onPress="MADB\Main\PanelController::closePanel">OK</Button>
        </ButtonBox>
      </PanelContent>
    </Panel>
    <Panel name="result-search">
      <PanelTitle>Search result</PanelTitle>
      <PanelContent>
        <Label>Search: <Input name="result-search-text" /></Label>
        <Label>Fields: <Select name="result-search-fields" hint="Fields" multiple="true" /></Label>
        <CheckBox name="result-search-regexp">Regexp</CheckBox>
        <CheckBox name="result-search-case-sensitive">Case sensitive</CheckBox><NL />
        <NL />
        <Label>
          Scope:<NL />
          <RadioButton name="result-search-scope-all" group="result-search-scope">All</RadioButton>
          <RadioButton name="result-search-scope-next" group="result-search-scope" value="true">Next</RadioButton>
          <RadioButton name="result-search-scope-previous" group="result-search-scope">Previous</RadioButton>
        </Label>
        <ButtonBox>
          <Button hotKey="RETURN" onPress="MADB\Main\ResultSearchController::doResultSearch">Search</Button><Space />
          <Button hotKey="ESCAPE" onPress="MADB\Main\ResultSearchController::closeResultSearchPanel">Cancel</Button>
        </ButtonBox>
      </PanelContent>
    </Panel>
    <Panel name="result-export">
      <PanelTitle>Export result</PanelTitle>
      <PanelContent>
        <HalfBoxLeft>
          <Label>
            Target:<NL />
            <RadioButton name="result-export-target-file" group="result-export-target" value="true" onChange="MADB\Main\ResultExportController::syncResultExportPanel">File</RadioButton>
            <RadioButton name="result-export-target-clipboard" group="result-export-target" onChange="MADB\Main\ResultExportController::syncResultExportPanel">Clipboard</RadioButton>
          </Label>
        </HalfBoxLeft>
        <HalfBoxRight>
          <Label name="result-export-file-row">File: <File name="result-export-file" start="~" create="true" /></Label>
        </HalfBoxRight>
        <HalfBoxLeft>
          <Label>
            Source:<NL />
            <RadioButton name="result-export-source-all" group="result-export-source" value="true">All</RadioButton>
            <RadioButton name="result-export-source-selection" group="result-export-source">Selection</RadioButton>
            <RadioButton name="result-export-source-rows" group="result-export-source">Rows</RadioButton>
            <RadioButton name="result-export-source-columns" group="result-export-source">Columns</RadioButton>
          </Label>
        </HalfBoxLeft>
        <HalfBoxRight>
          <Label>Max rows:
            <Input name="result-export-max-rows"/>
          </Label>
        </HalfBoxRight>
        <NL /><NL />
        <Tabs name="result-export-format-tabs" onChange="MADB\Main\ResultExportController::syncResultExportFormat">
          <Tab contentName="result-export-format-delimited">CSV/TSV</Tab>
          <Tab contentName="result-export-format-json">JSON</Tab>
          <Tab contentName="result-export-format-sql">SQL INSERT</Tab>
          <Tab contentName="result-export-format-markdown">Markdown</Tab>
          <Tab contentName="result-export-format-html">HTML</Tab>
          <Tab contentName="result-export-format-xml">XML</Tab>
        </Tabs>
        <TabBox name="result-export-format-delimited" class="result-export-format-tab">
          <Label>
            Preset:<NL />
            <RadioButton name="result-export-delimited-preset-csv" group="result-export-delimited-preset" value="true" onChange="MADB\Main\ResultExportController::syncResultDelimitedPreset">CSV</RadioButton>
            <RadioButton name="result-export-delimited-preset-tsv" group="result-export-delimited-preset" onChange="MADB\Main\ResultExportController::syncResultDelimitedPreset">TSV</RadioButton>
            <RadioButton name="result-export-delimited-preset-user" group="result-export-delimited-preset">User defined</RadioButton>
          </Label>
          <HalfBoxLeft>
            <Label>Field separator: <Input name="result-export-delimited-separator" onChange="MADB\Main\ResultExportController::syncResultDelimitedCustomPreset" /></Label>
            <Label>String delimiter: <Input name="result-export-delimited-string-delimiter" onChange="MADB\Main\ResultExportController::syncResultDelimitedCustomPreset" /></Label>
            <Label>Line end: <Input name="result-export-delimited-line-end" onChange="MADB\Main\ResultExportController::syncResultDelimitedCustomPreset" /></Label>
            <Label>Escape char: <Input name="result-export-delimited-escape-char" onChange="MADB\Main\ResultExportController::syncResultDelimitedCustomPreset" /></Label>
          </HalfBoxLeft>
          <HalfBoxRight>
            <CheckBox name="result-export-delimited-headers">Include headers</CheckBox><NL /><NL />
            <Label>NULL text: <Input name="result-export-delimited-null-text" /></Label>
          </HalfBoxRight>
        </TabBox>
        <TabBox name="result-export-format-json" class="result-export-format-tab">
          <CheckBox name="result-export-json-headers">Use column names</CheckBox><NL />
          <CheckBox name="result-export-json-pretty">Pretty JSON</CheckBox><NL />
          <CheckBox name="result-export-json-unescaped-unicode">Unescaped unicode</CheckBox><NL />
          <CheckBox name="result-export-json-unescaped-slashes">Unescaped slashes</CheckBox><NL />
          <CheckBox name="result-export-json-unescaped-lineterm">Unescaped line terminators</CheckBox><NL />
        </TabBox>
        <TabBox name="result-export-format-sql" class="result-export-format-tab">
          <CheckBox name="result-export-sql-add-info">Add info</CheckBox><NL /><NL />
          <Label>Schema: <Input name="result-export-sql-schema" /></Label>
          <Label>Table: <Input name="result-export-sql-table" /></Label>
          <Label>Rows per insert: <Input name="result-export-sql-group-insert" /></Label>
        </TabBox>
        <TabBox name="result-export-format-markdown" class="result-export-format-tab">
          <CheckBox name="result-export-markdown-headers">Include headers</CheckBox><NL /><NL />
          <Label>
            Multiline:<NL />
            <RadioButton name="result-export-markdown-line-collapse" group="result-export-markdown-line" value="true">Collapse</RadioButton>
            <RadioButton name="result-export-markdown-line-br" group="result-export-markdown-line" value="true">BR tag</RadioButton>
            <RadioButton name="result-export-markdown-line-literal" group="result-export-markdown-line" value="true">Literal \n</RadioButton>
          </Label>
          <Label>NULL text: <Input name="result-export-markdown-null-text" /></Label>
          <Label>Max cell length: <Input name="result-export-markdown-length" /></Label>
        </TabBox>
        <TabBox name="result-export-format-html" class="result-export-format-tab">
          <CheckBox name="result-export-html-headers">Include headers</CheckBox><NL />
          <CheckBox name="result-export-html-document">Full document</CheckBox><NL />
          <CheckBox name="result-export-html-multiline">Allow new lines</CheckBox><NL /><NL />
          <Label>NULL text: <Input name="result-export-html-null-text" /></Label>
          <Label>Title: <Input name="result-export-html-title" /></Label>
        </TabBox>
        <TabBox name="result-export-format-xml" class="result-export-format-tab">
          <CheckBox name="result-export-xml-declaration">XML declaration</CheckBox><NL />
          <CheckBox name="result-export-xml-compact">Compact rows</CheckBox><NL /><NL />
          <Label>Root element: <Input name="result-export-xml-root" /></Label>
          <Label>Row element: <Input name="result-export-xml-row" /></Label>
          <Label>Field element: <Input name="result-export-xml-field" placeholder="Empty: use field names as tags" /></Label>
          <Label>NULL text: <Input name="result-export-xml-null-text" /></Label>
        </TabBox>
        <ButtonBox>
          <Button hotKey="RETURN" onPress="MADB\Main\ResultExportController::doResultExport">Export</Button><Space />
          <Button hotKey="ESCAPE" onPress="MADB\Main\PanelController::closePanel">Cancel</Button>
        </ButtonBox>
      </PanelContent>
    </Panel>
    <Panel name="query-search">
      <PanelTitle>Search and replace</PanelTitle>
      <PanelContent>
        <Label>Search: <Input name="search" /></Label>
        <Label name="query-search-replace-row">Replace: <Input name="replace" /></Label>
        <CheckBox name="replaceEnabled" onChange="MADB\Main\QuerySearchController::syncSearchPanel">Replace</CheckBox>
        <CheckBox name="regexp">Regexp</CheckBox>
        <CheckBox name="caseSensitive">Case sensitive</CheckBox><NL />
        <NL />
        <Label>
          Scope:<NL />
          <RadioButton name="scopeAll" group="query-search-scope">All</RadioButton>
          <RadioButton name="scopeNext" group="query-search-scope" value="true">Next</RadioButton>
          <RadioButton name="scopePrevious" group="query-search-scope">Previous</RadioButton>
          <RadioButton name="scopeAfter" group="query-search-scope">After cursor</RadioButton>
          <RadioButton name="scopeBefore" group="query-search-scope">Before cursor</RadioButton>
        </Label>
        <ButtonBox>
          <Button hotKey="RETURN" onPress="MADB\Main\QuerySearchController::doSearchQuery">Search</Button><Space />
          <Button hotKey="ESCAPE" onPress="MADB\Main\QuerySearchController::closeSearchPanel">Cancel</Button>
        </ButtonBox>
      </PanelContent>
    </Panel>
  </Screen>
</Root>
