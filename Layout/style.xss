Window {
  width: max;
  height: max;
  backgroundColor: #000000;
  color: #ffff00;
}

MenuBox {
  minWidth: 150px;
}

ConnectionType {
  color: #0000cc;
  position: absolute;
  x: -0px;
}

Screen {
  backgroundColor: #0000aa;
  position: absolute;
  width: 100%;
  height: -20px;
  y: 20px;
}

.license {
  width: -256px;
  ascent: 256px;
}

.license-text {
  height: 450px;
}

.version {
  position: absolute;
  x: 0px;
  y: 270px;
  width: 256px;
  textAlign: center;
}

#query-editor-container {
  position: absolute;
  width: 75%;
  height: 30%;
  x: 0px;
  y: 0px;
}

.query-editor-full {
  height: 100%;
}

#query-result-container {
  position: absolute;
  width: 75%;
  height: 70%;
  x: 0px;
  y: -0px;
}

#query-list-container {
  position: absolute;
  width: 25%;
  height: 100%;
  x: -0px;
  y: 0px;
}

#query-editor {
  position: absolute;
  x: 10px;
  y: 20px;
  width: -20px;
  height: -40px;
  border: 2px;
  borderColor: #aaaaaa;
}

#query-title {
  x: 10px;
  y: 10px;
  width: -20px;
  height: 20px;
  backgroundColor: #aaaaaa;
  color: #555555;
}

#connection-info {
  x: 10px;
  y: 2px;
}

#query-name {
  x: -10px;
  y: 2px;
}

#query-result {
  position: absolute;
  x: 10px;
  y: 0px;
  width: -20px;
  height: -10px;
  border: 2px;
  borderColor: #aaaaaa;
}

#query-list {
  position: absolute;
  x: 0px;
  y: 10px;
  width: -10px;
  height: -20px;
  border: 2px;
  borderColor: #aaaaaa;
}

.query-pinned {
  color: #ffffff;
}

.active-box {
  borderColor: #dddddd;
}

.active-title {
  backgroundColor: #dddddd;
  color: #000000;
}

#schema-create {
  maxWidth: 640px;
}

#table-editor {
  width: 70%w;
}

#table-column-editor {
  width: 50%w;
}

.column-type-list {
  height: content;
}

.table-editor-tab {
  height: 50%h;
}

.table-editor-list {
  height: 100%;
}

.table-editor-list-with-header {
  height: -20px;
}

#storage-type {
  height: content;
}

#index-type {
  height: content;
}
