Window {
  width: max;
  height: max;
  backgroundColor: #000000;
  color: #ffff00;
}

MenuBox {
  minWidth: 150px;
}

ConnectionType {
  color: #0000cc;
  position: absolute;
  x: -0px;
}

Screen {
  position: absolute;
  width: 100%;
  height: -20px;
  y: 20px;
}

.screen-background {
  backgroundColor: #000088;
}

.license {
  width: -256px;
  ascent: 256px;
}

.license-text {
  height: 450px;
}

.version {
  position: absolute;
  x: 0px;
  y: 270px;
  width: 256px;
  textAlign: center;
}

#query-editor-container {
  position: absolute;
  width: 75%;
  height: 30%;
  x: 0px;
  y: 0px;
}


#query-editor:active {
  backgroundColor: #0000aa;
  color: #aaaaaa;
}

#query-editor:cursor {
  backgroundColor: #000000;
  color: #00cccc;
}

#query-editor:inactive-cursor {
  backgroundColor: #444444;
  color: #00aaaa;
}

.sql-keyword {
  color: #ffffff;
}

.sql-function {
  color: #ffff00;
}

.sql-identifier {
  color: #00ffff;
}

.sql-string {
  color: #00ff00;
}

.sql-number {
  color: #ff55ff;
}

.sql-variable,
.sql-placeholder {
  color: #ffaa00;
}

.sql-marker {
  color: #ff8800;
}

.sql-comment {
  color: #777777;
}

.sql-operator,
.sql-boundary {
  color: #dddddd;
}

.sql-error {
  backgroundColor: #aa0000;
  color: #ffffff;
}

.mongo-keyword {
  color: #ffffff;
}

.mongo-method {
  color: #ffff00;
}

.mongo-identifier {
  color: #00ffff;
}

.mongo-field,
.mongo-variable {
  color: #ffaa00;
}

.mongo-string {
  color: #00ff00;
}

.mongo-number {
  color: #ff55ff;
}

.mongo-comment {
  color: #777777;
}

.mongo-operator,
.mongo-boundary {
  color: #dddddd;
}

.mongo-error {
  backgroundColor: #aa0000;
  color: #ffffff;
}

.query-editor-full {
  height: 100%;
}

.query-editor-title-only {
  height: 40px;
}

#query-result-container {
  position: absolute;
  width: 75%;
  height: 70%;
  x: 0px;
  y: -0px;
}

.query-result-expanded {
  height: -40px;
  y: 40px;
}

#query-list-container {
  position: absolute;
  width: 25%;
  height: 100%;
  x: -0px;
  y: 0px;
}

#query-editor {
  position: absolute;
  x: 10px;
  y: 20px;
  width: -20px;
  height: -40px;
  border: 2px;
  borderColor: #aaaaaa;
  backgroundColor: #000088;
  color: #aaaaaa;
}

.query-editor-readonly {
  borderColor: #ffff00;
}

#query-title {
  x: 10px;
  y: 10px;
  width: -20px;
  height: 20px;
  backgroundColor: #aaaaaa;
  color: #555555;
}

.query-title-readonly {
  backgroundColor: #ffff00;
  color: #000000;
}

#connection-info {
  x: 10px;
  y: 2px;
}

#query-name {
  x: -10px;
  y: 2px;
}

#query-result {
  position: absolute;
  x: 10px;
  y: 0px;
  width: -20px;
  height: -10px;
  border: 2px;
  borderColor: #aaaaaa;
  backgroundColor: #000088;
}

#query-result:active {
  backgroundColor: #0000aa;
}

#query-result-message {
  position: absolute;
  x: 0px;
  y: 0px;
  width: 100%;
  height: 100%;
  color: #aaaaaa;
}

#query-result-status {
  position: absolute;
  x: 0px;
  y: 0px;
  width: 100%;
  height: 100%;
  border: 0px;
  padding: 0px;
  backgroundColor: #000088;
  color: #aaaaaa;
  scrollable: true;
  textWrap: manual;
}

#query-result-status:active {
  backgroundColor: #0000aa;
  color: #aaaaaa;
}

#query-result-table {
  position: absolute;
  x: 0px;
  y: 0px;
  width: 100%;
  height: 100%;
  backgroundColor: #000088;
  color: #aaaaaa;
  border: 0px;
}

#query-result-table:active {
  backgroundColor: #0000aa;
}

#query-result-preview {
  position: absolute;
  x: 10px;
  y: 20px;
  width: -20px;
  height: -40px;
  border: 2px;
  borderColor: #aaaaaa;
  backgroundColor: #000088;
  color: #aaaaaa;
  margin: 10px, 0px;
  padding: 10px;
}

#query-result-preview:active {
  backgroundColor: #0000aa;
}

.query-result-preview-text {
  position: absolute;
  x: 0px;
  y: 0px;
  width: 100%;
  height: 100%;
  border: 0px;
  scrollable: false;
}

#query-field-value {
  width: 60%w;
}

.query-field-value-text {
  width: 100%;
  height: 35%h;
}

#mongodb-document-editor {
  width: 60%w;
}

.mongodb-document-editor-text {
  width: 100%;
  height: 35%h;
}

#help {
  width: 60%;
}

.help-tab {
  width: 100%;
  height: 60%h;
}

.help-text {
  width: 100%;
  height: 100%;
  scrollable: true;
  textWrap: auto;
}

#table-insert {
  width: 55%;
  height: 80%;
}

#table-insert-content {
  height: -17px;
  scrollable: false;
}

#table-insert-fields {
  position: absolute;
  x: 0px;
  y: 0px;
  width: 100%;
  height: -60px;
  border: 1px;
  borderColor: #000000;
  scrollable: true;
}

.table-insert-list-value {
  color: #000000;
}

#table-insert-buttons {
  position: absolute;
  x: 0px;
  y: -0px;
  width: 100%;
  height: 50px;
  marginTop: 0px;
  scrollable: false;
}

#table-insert-field-editor {
  width: 65%;
  height: content;
}

.table-insert-field-label {
  width: 100%;
}

#table-insert-field-name,
#table-insert-field-type {
  width: 100%;
}

.table-insert-input {
  width: 100%;
}

.table-insert-text {
  width: 100%;
  height: 200px;
}

#table-insert-preview,
#table-delete-preview {
  width: 85%;
  height: content;
}

#table-insert-preview-text,
#table-delete-preview-text {
  width: 100%;
  height: 60%h;
  border: 1px;
  borderColor: #000000;
}

#query-list {
  position: absolute;
  x: 0px;
  y: 10px;
  width: -10px;
  height: -20px;
  border: 2px;
  borderColor: #aaaaaa;
  backgroundColor: #000088;
  color: #aaaaaa;
}

#query-list:active {
  backgroundColor: #0000aa;
}

.query-pinned {
  color: #ffff00;
}

.active-box {
  borderColor: #dddddd;
}

.active-title {
  backgroundColor: #dddddd;
  color: #000000;
}

#schema-create {
  maxWidth: 640px;
}

#table-editor {
  width: 70%w;
}

#sqlite-table-create {
  width: 70%w;
}

#table-column-editor {
  width: 50%w;
}

#sqlite-column-editor {
  width: 50%w;
}

#sqlite-trigger-editor {
  width: 65%w;
}

.result-export-format-tab {
  height: 350px;
}

.column-type-list {
  height: content;
}

.table-editor-tab {
  height: 50%h;
}

.sqlite-table-tab {
  height: 50%h;
}

.table-editor-list {
  height: 100%;
}

.sqlite-table-list {
  height: 100%;
}

.table-editor-list-with-header {
  height: -20px;
}

.sqlite-table-list-with-header {
  height: -20px;
}

#storage-type {
  height: content;
}

#index-type {
  height: content;
}

TableHeader {
  position: absolute;
  x: calculated;
  y: calculated;
  backgroundColor: #aaaaaa;
  color: #555555;
  padding: 1px, 5px;
  borderRight: 1px;
  borderColor: #aaaaaa;
}

TableHeader:active {
  backgroundColor: #dddddd;
  color: #000000;
}

TableCell {
  position: absolute;
  x: calculated;
  y: calculated;
  padding: 1px, 5px;
  borderRight: 1px;
  borderColor: #aaaaaa;
}

TableCell:search {
  backgroundColor: #66ccff;
}

TableCell:search-active {
  backgroundColor: #ffff00;
  color: #000000;
}

TableCell:cursor,
TableCell:selection {
  backgroundColor: #000000;
  color: #ffffff;
}

TableCell:inactive-cursor,
TableCell:inactive-selection {
  backgroundColor: #555555;
  color: #ffffff;
}

Word:tableNull,
Word:tableMarker {
  color: #ffff00;
}

#foreign-key-column,
#foreign-key-target-column,
#sqlite-foreign-key-column,
#sqlite-foreign-key-target-column {
  height: 20%h;
}

#foreign-key-delete-rule/panel,
#foreign-key-update-rule/panel,
#sqlite-foreign-key-delete-rule/panel,
#sqlite-foreign-key-update-rule/panel,
#trigger-timing/panel,
#trigger-event/panel,
#sqlite-trigger-timing/panel,
#sqlite-trigger-event/panel,
#view-algorithm/panel,
#view-security/panel,
#view-check-option/panel {
  width: 20%w;
}
#foreign-key-delete-rule/list,
#foreign-key-update-rule/list,
#sqlite-foreign-key-delete-rule/list,
#sqlite-foreign-key-update-rule/list,
#trigger-timing/list,
#trigger-event/list,
#sqlite-trigger-timing/list,
#sqlite-trigger-event/list,
#view-algorithm/list,
#view-security/list,
#view-check-option/list {
  height: content;
}

#table-charset/panel,
#column-charset/panel,
#table-collation/panel,
#column-collation/panel {
  width: 30%w;
}

#foreign-key-target-schema/panel,
#foreign-key-target-table/panel,
#sqlite-foreign-key-target-table/panel {
  width: 40%w;
}
