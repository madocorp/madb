Window {
  width: 100%;
  height: 100%;
  x: 0;
  y: 0;
  backgroundColor: #000000;
  color: #ffff00;
}

ConnectionType {
  color: #0000cc;
  position: absolute;
  x: -0px;
}

.license {
  position: absolute;
  x: -0px;
  y: 0px;
  width: -256px;
}

.license-text {
  height: 450px;
}

.version {
  position: absolute;
  x: 0px;
  y: 270px;
  width: 256px;
  textAlign: center;
}